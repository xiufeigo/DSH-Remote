<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	package="top.d1studio.dshremote">
	<!-- versionCode/versionName 不在此写死：由 android/build.ps1 从仓库根 package.json
	     推导，构建时经 aapt2 link 注入（规则见 docs/versioning.md）。 -->

	<uses-permission android:name="android.permission.INTERNET" />
	<!-- frpc visitor 前台服务（stcp/xtcp 隧道保活）。
	     AND-02：类型由 dataSync 改为 specialUse（dataSync 在 Android 14+ 有累计时长限制）。 -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

	<application
		android:label="DSH Remote"
		android:icon="@mipmap/ic_launcher"
		android:allowBackup="false"
		android:networkSecurityConfig="@xml/network_security_config"
		android:forceDarkAllowed="false"
		android:theme="@style/AppTheme">
		<activity
			android:name=".MainActivity"
			android:exported="true"
			android:launchMode="singleTask"
			android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden|uiMode"
			android:windowSoftInputMode="adjustResize">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
			<!-- 扫码导入：PC 端 dsh-remote visitor 生成二维码，任意第三方扫码器
			     打开 dsh-remote://visitor?... 链接时系统会弹到本 App 接管 -->
			<intent-filter>
				<action android:name="android.intent.action.VIEW" />
				<category android:name="android.intent.category.DEFAULT" />
				<category android:name="android.intent.category.BROWSABLE" />
				<data android:scheme="dsh-remote" android:host="visitor" />
			</intent-filter>
		</activity>

		<!-- T39：WebView 文件选择器兜底通道。选择器返回的 content:// URI 读不到时，
		     把内容复制进私有缓存并由本 provider 以一个必然可读、名称/大小都准确的
		     URI 交给 WebView，截断"选完什么都不显示且全程无报错"这条静默链路。
		     exported=false：WebView 的 onReceiveValue(Uri[]) 在本进程内经
		     ContentResolver 打开 URI（渲染进程只收字节），因此无需对外导出；
		     grantUriPermissions=true：保留框架按 URI 授权的能力。 -->
		<provider
			android:name=".ChooserCacheProvider"
			android:authorities="top.d1studio.dshremote.choosercache"
			android:exported="false"
			android:grantUriPermissions="true" />

		<!-- AND-02：specialUse 前台服务类型，必须随附用途声明（商店审核材料）。 -->
		<service
			android:name=".TunnelService"
			android:exported="false"
			android:foregroundServiceType="specialUse">
			<property
				android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
				android:value="远程访问用户自有 PC 的加密隧道代理" />
		</service>
	</application>
</manifest>
