# ============================================================================
# DSH-Remote Edge · 环境变量（cp 为 .env 后填写）
# ============================================================================

# ── 必填 ────────────────────────────────────────────────────────────────────
# 你的域名（需已解析到本服务器 A/AAAA 记录；Caddy 据此自动签发 HTTPS 证书）
DSHR_DOMAIN=remote.example.com

# 前置访问 Token：iPhone/iPad 首次访问时输入的口令（建议 ≥16 位随机串）
# 生成示例：openssl rand -base64 24
# 轮换：改这里后 `docker compose up -d` 重建即生效；已登录设备不受影响，
#       如需全体下线，删除 data/state/devices.json 后重启。
DSHR_ACCESS_TOKEN=

# ── frp 角色（二选一）───────────────────────────────────────────────────────
# frps   = 容器自带 frps（推荐）：家里 PC 的 frpc 直接连本机 7000 控制口，
#          容器内部自动起 visitor 回环消费隧道。安全组放行 7000/tcp。
# visitor = 你已另有 frps 在运行（比如按 scripts/install-frps.sh 装好的那台）：
#          容器作为访客连过去。填 DSHR_FRP_SERVER_ADDR 为那台 frps 地址，
#          并删掉 compose 里 7000 端口映射。
DSHR_FRP_ROLE=frps

# frps 控制端口（两种角色下含义一致：frps 监听 / 外部 frps 的控制口）
DSHR_FRP_SERVER_PORT=7000

# 隧道名：必须与 PC 端 config.json 的 frp.name 一致！
# 多人共用一台 frps 时必须互不相同。
DSHR_FRP_NAME=dsh-remote

# 仅 FRP_ROLE=visitor 时必填：外部 frps 的地址
DSHR_FRP_SERVER_ADDR=

# 仅 FRP_ROLE=frps 时相关：
# PC 端接入形态 stcp（推荐）/ entry-port（PC 用 entry 形态绑 remotePort 进来）
DSHR_EDGE_CONSUME=stcp
# frps 允许 PC 申请的入口端口段（entry-port 消费或以后想开 entry 才用得到）
DSHR_FRPS_ALLOW_PORTS=18400-18500
# 对外暴露控制口的宿主端口（FRP_ROLE=visitor 时请把 compose 里该映射删掉）
DSHR_FRPS_CONTROL_EXPOSE=7000

# ── 可调项（保持缺省即可）───────────────────────────────────────────────────
# Token 登录后的设备 Cookie 有效期（天）
DSHR_TOKEN_LOGIN_DAYS=30
# 移动 hook 断点（px）：视口 ≤ 该值启用窄屏布局；iPad 横屏 ≥1024 自然走官方桌面布局
DSHR_MOBILE_BREAKPOINT=980
# 上游是否 HTTPS（隧道对端是 PC 网关的自签服务；除非你明确知道自己在做什么，别改）
DSHR_UPSTREAM_TLS=true
# visitor 在容器内的本地绑定端口（= 网关生效上游端口）
DSHR_VISITOR_BIND_PORT=18443
# 反代后是否信任 X-Forwarded-For 作为限流键（GW-03）。网关侧的采信条件：
# 本项 =true 且直连来源是回环或命中下方 DSHR_TRUST_PROXY_CIDRS 时，才取该头最左一跳。
#   - 裸机部署（宿主机 Caddy/nginx → 127.0.0.1:18443）：设 true 即生效（回环来源）；
#   - compose 桥接网络：caddy→gateway 源地址是容器网段 IP，需同时设 true 并配置
#     DSHR_TRUST_PROXY_CIDRS 覆盖该网段（受信网段配错的后果 = 伪造 XFF 可绕过限流，
#     因此只应填反代所在网段，切勿填 0.0.0.0/0）。
# 缺省 false = 一律按 socket 直连地址限流。
DSHR_TRUST_PROXY_XFF=false
# 受信代理 CIDR 列表（逗号分隔，如 "172.16.0.0/12"）。docker compose 默认桥接网段
# 通常落在 172.16.0.0/12；请按实际子网调整（docker network inspect 查看）。
# 仅在 DSHR_TRUST_PROXY_XFF=true 时参与判定。
DSHR_TRUST_PROXY_CIDRS=172.16.0.0/12
